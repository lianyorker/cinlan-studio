[Unit]
Description=Cinlan Studio web
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cinlan
Group=cinlan
WorkingDirectory=/opt/cinlan-studio
EnvironmentFile=/etc/cinlan-studio.env
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
