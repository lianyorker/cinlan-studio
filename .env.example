# API service used for model catalog, accounts, uploads, and generation.
# Leave empty when the API is exposed from the same origin.
NEXT_PUBLIC_API_URL=

# Optional dashboard where users create and manage API keys.
NEXT_PUBLIC_DASHBOARD_URL=

# Server-side BFF settings
SUB2API_BASE_URL=https://api.cinlan.online
# Studio capability routing. A missing capability group hides that navigation item.
SUB2API_STUDIO_IMAGE_GROUP_ID=
SUB2API_STUDIO_TEXT_GROUP_ID=
SUB2API_STUDIO_VIDEO_GROUP_ID=
# Optional exact model overrides, for example: {"gpt-image-2":7,"sora-2":9}
SUB2API_STUDIO_MODEL_GROUP_MAP={}
# Legacy image-only alias. Prefer SUB2API_STUDIO_IMAGE_GROUP_ID.
SUB2API_STUDIO_GROUP_ID=
# Manual sk-* login is disabled by default; account login, 2FA and embedded SSO remain available.
CINLAN_ALLOW_API_KEY_LOGIN=false
# Keep stable and identical across all Web and Worker instances sharing the database.
CINLAN_STUDIO_INSTALLATION_ID=cinlan-studio-production
CINLAN_SESSION_SECRET=replace-with-a-long-random-secret
# Keep true behind HTTPS. Set false only for a temporary plain-HTTP deployment.
CINLAN_COOKIE_SECURE=true

# Set when the Studio is embedded as an iframe under Sub2API.
CINLAN_EMBEDDED=false
# Space-separated CSP frame ancestors, for example: 'self' https://sub2api.example.com
CINLAN_FRAME_ANCESTORS='self'
CINLAN_ALLOWED_ORIGINS=

# PostgreSQL-only Creative Core. Run `npm run db:migrate` before enabling it.
DATABASE_URL=
CREATIVE_ASSET_STORAGE_DIR=./data/assets
CREATIVE_DATABASE_POOL_SIZE=10
CREATIVE_WORKER_CONCURRENCY=2
CREATIVE_WORKER_INTERVAL_MS=1000
# Keep false when the independent production worker is running.
CREATIVE_IN_PROCESS_WORKER=false
CREATIVE_PLANNER_ENABLED=true
CREATIVE_PLANNER_MODEL=gpt-5.2
CREATIVE_PLANNER_EFFORT=xhigh
# Optional Alibaba Cloud VIAPI subject extraction for complex photos.
# Checkerboard/simple-background alpha PNG export runs locally and does not need these keys.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_REGION_ID=cn-shanghai
ALIBABA_CLOUD_IMAGESEG_ENDPOINT=imageseg.cn-shanghai.aliyuncs.com
PGSSLMODE=
PGSSL_REJECT_UNAUTHORIZED=true

# Dedicated disposable database used only by `npm run test:postgres`.
# Never point this at production; the test creates and drops a random schema.
CINLAN_TEST_DATABASE_URL=
